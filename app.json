{
  "expo": {
    "name": "LENTERA",
    "slug": "tautjiwa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/lentera-icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/lentera-icon.png",
      "backgroundColor": "#FFFFFF",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.danipinion.tautjiwa"
    },
    "android": {
      "package": "com.danipinion.tautjiwa",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/lentera-icon.png"
      },
      "permissions": [
        "android.permission.VIBRATE",
        "android.permission.INTERNET",
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "LENTERA memakai mikrofon hanya saat kamu menekan tombol suara di latihan grounding. Tidak ada rekaman yang disimpan atau dikirim.",
          "speechRecognitionPermission": "LENTERA mengubah ucapanmu menjadi teks di perangkat ini saja, supaya latihan grounding bisa dilakukan tanpa mengetik.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.as",
            "com.google.android.tts"
          ]
        }
      ]
    ]
  }
}
